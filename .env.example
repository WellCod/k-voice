# Banco de dados
DATABASE_URL=postgresql+asyncpg://kvoice:kvoice@localhost:5432/kvoice

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_OUTPUTS=kvoice-outputs
S3_BUCKET_REFERENCES=kvoice-references

# ElevenLabs (fallback)
ELEVENLABS_API_KEY=

# Qwen3-TTS
QWEN3_ENABLED=false
# cpu no notebook de dev; cuda nos nós com GPU NVIDIA (exige torch com CUDA)
QWEN3_DEVICE=cpu
# auto = float32 em CPU, bfloat16 em CUDA
QWEN3_DTYPE=auto
# Streaming em GPU: passos do codec por pedaço (~chunk_size/12 s de áudio)
QWEN3_CHUNK_SIZE=8
# Hosts aceitos em /mcp, em JSON (ex.: ["voz.exemplo.com.br"]). Vazio: sem checagem de Host.
MCP_ALLOWED_HOSTS=[]
# Cache em memória do áudio de frases curtas repetidas (por processo); 0 desliga.
AUDIO_CACHE_MB=64
AUDIO_CACHE_MAX_CHARS=200
AUDIO_CACHE_TTL_S=86400
# Validade do cache de token, voz, regra e dicionário (s), por processo; 0 desliga.
QUERY_CACHE_TTL_S=30

# Chave do áudio de referência cifrado em repouso. Gerar com:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REFERENCE_AUDIO_KEY=

# Aplicação
SECRET_KEY=troque-em-producao
LOG_LEVEL=INFO

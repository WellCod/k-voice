# Banco de dados
DATABASE_URL=postgresql+asyncpg://kvoice:kvoice@localhost:5432/kvoice

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_OUTPUTS=kvoice-outputs
S3_BUCKET_REFERENCES=kvoice-references

# ElevenLabs (fallback)
ELEVENLABS_API_KEY=

# Qwen3-TTS
QWEN3_ENABLED=false
# cpu no notebook de dev; cuda nos nós com GPU NVIDIA (exige torch com CUDA)
QWEN3_DEVICE=cpu
# auto = float32 em CPU, bfloat16 em CUDA
QWEN3_DTYPE=auto

# Aplicação
SECRET_KEY=troque-em-producao
LOG_LEVEL=INFO
